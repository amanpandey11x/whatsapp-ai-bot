# Copy this file to .env and fill in your real values. Never commit .env itself.

DJANGO_SECRET_KEY=change-this-to-a-random-secret-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.ngrok-free.app,.ngrok-free.dev,.ngrok.io

# Meta WhatsApp Cloud API — get these from developers.facebook.com
WHATSAPP_VERIFY_TOKEN=choose-any-random-string-yourself
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token-here
META_PHONE_NUMBER_ID=your-phone-number-id-here
META_WA_BUSINESS_ACCOUNT_ID=your-business-account-id-here
# Optional: LLM provider key if you wire one up in whatsapp_bot/services.py
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: id of a published WhatsApp Flow for the ITR add-on multi-select
# screen (see docs/whatsapp_flows/README.md). Leave blank to keep the
# tap-one-at-a-time add-on list — nothing else needs this.
WHATSAPP_ADDON_FLOW_ID=

# Optional: id of the published, server-driven "mega" service Flow (service
# category through add-ons/quantities to a final review — see
# docs/whatsapp_flows/README.md). Requires WHATSAPP_FLOW_ENDPOINT_URL and the
# public-key setup (manage.py setup_flow_encryption) to already be done.
WHATSAPP_SERVICE_FLOW_ID=

# Publicly reachable HTTPS URL for this project's /api/whatsapp/flow/ path —
# only needed once, to register the mega Flow's data-exchange endpoint via
# `manage.py create_service_flow`.
WHATSAPP_FLOW_ENDPOINT_URL=

# Celery / Redis — default works if you run Redis locally on default port
CELERY_BROKER_URL=redis://localhost:6379/0

# Optional: Postgres connection string, e.g. postgres://user:pass@host:5432/dbname.
# Leave blank to keep using the local db.sqlite3 file — fine for dev, but
# switch this before taking real payments (see myproject/settings.py).
DATABASE_URL=

# Razorpay — leave blank to keep payment links disabled everywhere (every
# call site checks this and no-ops instead of erroring).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Configured separately, on the Razorpay dashboard's webhook settings page —
# not the same value as RAZORPAY_KEY_SECRET.
RAZORPAY_WEBHOOK_SECRET=
# Hours a payment link stays open before expiring (default 48 — long on
# purpose, see myproject/settings.py).
PAYMENT_LINK_EXPIRY_HOURS=48
# Flat advance/booking-fee amount (INR) charged against an "onwards"-priced
# quote instead of the full, still-uncertain total.
PAYMENT_ADVANCE_AMOUNT=499

# Slack Incoming Webhook for services.notify_human_alert (hot-lead flip, bad
# CSAT, HELP request, callback booking, payment failure). Create at
# https://api.slack.com/messaging/webhooks. Leave blank to keep the
# admin-only /admin/ flag with no live push.
SLACK_HOT_LEAD_WEBHOOK_URL=
